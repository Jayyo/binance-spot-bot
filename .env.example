# Copy to .env (chmod 600 .env). Backtests and paper trading need nothing here.
# Variables already set in the environment take precedence over this file.

# Spot Testnet (fake funds): https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# or, for an Ed25519 key registered on the testnet:
# BINANCE_TESTNET_PRIVATE_KEY_PATH=./testnet-ed25519.pem

# Live exchange (real funds). Trade-only, IP-restricted key; see docs/api-keys.md.
BINANCE_API_KEY=
BINANCE_PRIVATE_KEY_PATH=./spotbot-ed25519.pem
# BINANCE_PRIVATE_KEY_PASSWORD=
# BINANCE_API_SECRET=   (HMAC keys; Binance marks them deprecated)
